# smistudy's part of the Caddyfile (Caddy runs in Docker; 172.18.0.1 is the host
# as seen from the Caddy container's network).

# 1) Global options — goes at the very top of the Caddyfile (merge into an existing { } block).
#    Trust CF-Connecting-IP only when the request really comes from Cloudflare, so
#    {client_ip} is the visitor's IP and can't be spoofed by hitting the server directly.
#    Ranges from https://www.cloudflare.com/ips/ — re-check them occasionally.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# 2) Site blocks.
smistudy.ca {
	tls /certs/smistudy-cert.pem /certs/smistudy-key.pem
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API: two Go processes. Requests to a down instance are retried on the other.
	handle /api/* {
		reverse_proxy 172.18.0.1:8081 172.18.0.1:8082 {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri /api/health
			health_interval 10s
			# Overwrite (never append) so clients can't fake their IP for rate limiting.
			header_up X-Real-IP {client_ip}
		}
	}

	# Website: two Next.js processes.
	handle {
		reverse_proxy 172.18.0.1:3101 172.18.0.1:3102 {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri /login
			health_interval 10s
		}
	}
}

www.smistudy.ca {
	tls /certs/smistudy-cert.pem /certs/smistudy-key.pem
	redir https://smistudy.ca{uri} permanent
}
