# Copied to /etc/smistudy.env by install.sh (root-only, mode 600). Edit there.
SMISTUDY_PUBLIC_URL=https://smistudy.ca
SMISTUDY_DB=__HOME__/smistudy-data/smistudy.db
SMISTUDY_DATA=__HOME__/smistudy-data/sessions.json
# Caddy overwrites this header with the real visitor IP (see deploy/caddy/smistudy.caddy).
SMISTUDY_CLIENT_IP_HEADER=X-Real-IP

# Google sign-in: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails (verification, password reset): https://resend.com
RESEND_API_KEY=
SMISTUDY_MAIL_FROM=smistudy <noreply@smistudy.ca>
