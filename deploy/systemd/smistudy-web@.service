# One Next.js process per instance; the instance name is its port: smistudy-web@3101
[Unit]
Description=smistudy web (port %i)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__HOME__/smistudy-releases/current/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=__NODE__ node_modules/next/dist/bin/next start -H 0.0.0.0 -p %i
Restart=always
RestartSec=2

# Sandboxing (no MemoryDenyWriteExecute: Node's JIT needs it).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
